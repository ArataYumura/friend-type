<script>
(function(){
    const params = new URLSearchParams(window.location.search);
    const titleParam = params.get('t');
    if (titleParam) {
        document.getElementById('type-code-title').innerText = titleParam;
    }

    const g = Math.max(0, Math.min(100, parseInt(params.get('g')) || 50));
    const s = Math.max(0, Math.min(100, parseInt(params.get('s')) || 50));
    const a = Math.max(0, Math.min(100, parseInt(params.get('a')) || 50));
    const h = Math.max(0, Math.min(100, parseInt(params.get('h')) || 50));
    const scores = [g, s, a, h];

    const colors = ["#A3E635", "#F472B6", "#38BDF8", "#FBBF24"]; 

    scores.forEach((val, i) => {
        const bar = document.getElementById('bar-' + i);
        const dot = document.getElementById('dot-' + i);
        const valL = document.getElementById('val-l-' + i);
        const valR = document.getElementById('val-r-' + i);
        const lblL = document.getElementById('lbl-l-' + i);
        const lblR = document.getElementById('lbl-r-' + i);

        valL.innerText = val + '%';
        valR.innerText = (100 - val) + '%';

        setTimeout(() => {
            dot.style.left = (100 - val) + '%';
            dot.style.border = "4px solid " + colors[i];
            
            if(val >= 50) {
                lblL.style.color = "#0F172A"; lblL.style.fontSize = "15px";
                lblR.style.color = "#94A3B8"; lblR.style.fontSize = "12px";
                bar.style.left = "0"; bar.style.right = (val) + "%"; bar.style.background = colors[i];
            } else {
                lblL.style.color = "#94A3B8"; lblL.style.fontSize = "12px";
                lblR.style.color = "#0F172A"; lblR.style.fontSize = "15px";
                bar.style.right = "0"; bar.style.left = (100 - val) + "%"; bar.style.background = colors[i];
            }
        }, 100);
    });
})();
</script>
